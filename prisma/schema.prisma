// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ADMIN
  MECHANIC
  OPERATIONS
  CHIEF_MECHANIC
}

enum SystemType {
  VRMS
  VMMS
  BMS
}

enum VehicleStatus {
  AVAILABLE
  UNDER_REPAIR
  UNDER_MAINTENANCE
}

enum WorkOrderStatus {
  PENDING
  IN_PROGRESS
  FOR_VERIFICATION
  COMPLETED
  CANCELLED
}

enum AccountType {
  IN_HOUSE
  OUTSOURCED
}

enum MaintenanceStatus {
  PENDING
  DUE
  IN_PROGRESS
  DONE
  COMPLETED
  OVERDUE
  CANCELLED
}

enum MaintenanceApprovalStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
  FOR_REPAIR
}

enum MaintenanceTriggerType {
  MANUAL
  ODOMETER
  TIME
}

enum MaintenanceIntervalType {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUALLY
  ANNUALLY
}

// ==========================================
// MODELS
// ==========================================

model User {
  id                       String                    @id @default(uuid()) @db.Uuid
  name                     String                    @db.VarChar(100)
  email                    String                    @unique @map("email") @db.VarChar(255)
  emailVerified            Boolean                   @default(false) @map("email_verified")
  passwordHash             String                    @map("password_hash") @db.VarChar(255)
  contact                  String?                   @db.VarChar(100)
  profilePicture           String?                   @map("profile_picture") @db.Text
  isActive                 Boolean                   @default(true) @map("is_active")
  failedLoginAttempts      Int                       @default(0) @map("failed_login_attempts")
  lockedAt                 DateTime?                 @map("locked_at") @db.Timestamptz(6)
  deletedAt                DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles                    UserRoleAssignment[]
  mechanic                 Mechanic?
  notifications            Notification[]
  maintenanceNotifications MaintenanceNotification[]
  passwordResetTokens      PasswordResetToken[]
  refreshTokens            RefreshToken[]
  loginActivities          LoginActivity[]
  chiefMechanicSchedules   MaintenanceSchedule[]     @relation("ScheduleChiefMechanic")
  assignedSchedules        MaintenanceSchedule[]     @relation("ScheduleMechanic")

  @@index([deletedAt])
  @@map("users")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @db.VarChar(200)
  message   String   @db.Text
  type      String   @default("info") @db.VarChar(30)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model UserRoleAssignment {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      UserRole
  system    SystemType
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, system])
  @@map("user_roles")
}

model Vehicle {
  id                String            @id @default(uuid()) @db.Uuid
  plateNumber       String            @unique @map("plate_number") @db.VarChar(20)
  make              String?           @db.VarChar(80)
  model             String            @db.VarChar(100)
  year              Int?
  engineType        String?           @map("engine_type") @db.VarChar(50)
  truckSizeCategory String?           @map("truck_size_category") @db.VarChar(50)
  capacity          Int               @default(0) @map("capacity")
  status            VehicleStatus     @default(AVAILABLE)
  odometer          Int               @default(0)
  garageId          String?           @map("garage_id") @db.Uuid
  workOrders        WorkOrder[]
  isActive          Boolean           @default(true) @map("is_active")
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  auditLogs         VehicleAuditLog[]
  garage            Garage?           @relation(fields: [garageId], references: [id], onDelete: Restrict)

  @@index([deletedAt])
  @@map("vehicles")
}

model Garage {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @unique @db.VarChar(50) // Sta. Rosa, Marikina, Pulilan
  isActive   Boolean     @default(true) @map("is_active")
  deletedAt  DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  vehicles   Vehicle[]
  workOrders WorkOrder[]

  @@index([deletedAt])
  @@map("garages")
}

model Mechanic {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @unique @map("user_id") @db.Uuid // Linked if in-house mechanic has a login
  name         String   @db.VarChar(100)
  isOutsourced Boolean  @default(false) @map("is_outsourced")
  shopName     String?  @map("shop_name") @db.VarChar(100) // For outsourced "Other" shop names
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  workOrders WorkOrder[] @relation("WorkOrderMechanics")

  @@map("mechanics")
}

enum MaintenancePriority {
  HIGH
  MEDIUM
  LOW
}

model WorkOrder {
  id                       String          @id @default(uuid()) @db.Uuid
  workOrderNumber          String          @unique @map("work_order_number") @db.VarChar(50)
  status                   WorkOrderStatus @default(PENDING)
  vehicleId                String          @map("vehicle_id") @db.Uuid
  garageId                 String          @map("garage_id") @db.Uuid
  odometer                 Int
  targetDueDate            DateTime?       @map("target_due_date") @db.Timestamptz(6)
  durationDays             Int?            @map("duration_days")
  durationHours            Int?            @map("duration_hours")
  partsCost                Decimal?        @map("parts_cost") @db.Decimal(10, 2)
  laborCost                Decimal?        @map("labor_cost") @db.Decimal(10, 2)
  totalCost                Decimal?        @map("total_cost") @db.Decimal(10, 2)
  isLumpSum                Boolean         @default(false) @map("is_lump_sum")
  cancellationReason       String?         @map("cancellation_reason") @db.Text
  failedVerificationReason String?         @map("failed_verification_reason") @db.Text
  remarks                  String?         @db.Text
  isUnlocked               Boolean         @default(false) @map("is_unlocked")
  unlockReason             String?         @map("unlock_reason") @db.Text
  isArchived               Boolean         @default(false) @map("is_archived")
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt              DateTime?       @map("completed_at") @db.Timestamptz(6)

  vehicle        Vehicle         @relation(fields: [vehicleId], references: [id])
  garage         Garage          @relation(fields: [garageId], references: [id])
  issues         RepairIssue[]
  mechanics      Mechanic[]      @relation("WorkOrderMechanics")
  repairParts    RepairPart[]
  shopChangeLogs ShopChangeLog[]
  auditLogs      AuditLog[]

  @@index([status, createdAt])
  @@index([vehicleId])
  @@map("work_orders")
}

model RepairIssue {
  id          String   @id @default(uuid()) @db.Uuid
  workOrderId String   @map("work_order_id") @db.Uuid
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("repair_issues")
}

model RepairPart {
  id          String   @id @default(uuid()) @db.Uuid
  workOrderId String   @map("work_order_id") @db.Uuid
  description String   @db.VarChar(255)
  unitCost    Decimal  @map("unit_cost") @db.Decimal(10, 2)
  quantity    Int      @default(1)
  subtotal    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("repair_parts")
}

model ShopChangeLog {
  id              String   @id @default(uuid()) @db.Uuid
  workOrderId     String   @map("work_order_id") @db.Uuid
  changedByUserId String   @map("changed_by_user_id") @db.Uuid
  changedByName   String   @map("changed_by_name") @db.VarChar(100)
  previousValue   String   @map("previous_value") @db.VarChar(255)
  newValue        String   @map("new_value") @db.VarChar(255)
  changedAt       DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("shop_change_logs")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  workOrderId   String   @map("work_order_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  email         String   @db.VarChar(100)
  action        String   @db.VarChar(100)
  fieldName     String?  @map("field_name") @db.VarChar(50)
  previousValue String?  @map("previous_value") @db.Text
  newValue      String?  @map("new_value") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId, createdAt])
  @@map("audit_logs")
}

model VehicleAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  vehicleId     String   @map("vehicle_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  email         String   @db.VarChar(100)
  action        String   @db.VarChar(100)
  fieldName     String   @map("field_name") @db.VarChar(50)
  previousValue String?  @map("previous_value") @db.Text
  newValue      String?  @map("new_value") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, createdAt])
  @@index([userId, createdAt])
  @@map("vehicle_audit_logs")
}

model ChecklistTemplate {
  id        String                @id @default(uuid()) @db.Uuid
  type      String                @db.VarChar(100) // Oil Change, Brake Inspection, etc.
  items     ChecklistItem[]
  schedules MaintenanceSchedule[]
  deletedAt DateTime?             @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([type])
  @@index([deletedAt])
  @@map("checklist_templates")
}

model ChecklistItem {
  id                  String    @id @default(uuid()) @db.Uuid
  checklistTemplateId String    @map("checklist_template_id") @db.Uuid
  text                String    @db.Text
  order               Int       @default(0)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  checklistTemplate ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id], onDelete: Cascade)

  @@index([checklistTemplateId])
  @@index([deletedAt])
  @@map("checklist_items")
}

model MaintenanceSchedule {
  id                         String                    @id @default(uuid()) @db.Uuid
  workOrderNumber            String                    @unique @default(dbgenerated("('WO-'::text || to_char(CURRENT_DATE, 'YYYYMMDD'::text) || '-'::text || lpad(nextval('maintenance_schedule_work_order_number_seq'::regclass)::text, 6, '0'::text))")) @map("work_order_number") @db.VarChar(32)
  vehicleId                  String                    @db.VarChar(50)
  title                      String                    @db.VarChar(100)
  garageId                   String?                   @map("garage_id") @db.VarChar(50)
  status                     MaintenanceStatus         @default(PENDING)
  priority                   MaintenancePriority       @default(MEDIUM)
  approvalStatus             MaintenanceApprovalStatus @default(UNVERIFIED) @map("approval_status")
  assignedMechanic           String                    @map("assigned_mechanic") @db.VarChar(100)
  assignedMechanicId         String?                   @map("assigned_mechanic_id") @db.Uuid
  chiefMechanicId            String?                   @map("chief_mechanic_id") @db.Uuid
  chiefMechanic              String?                   @map("chief_mechanic") @db.VarChar(100)
  accountType                AccountType?              @map("account_type")
  checklistTemplateId        String?                   @map("checklist_template_id") @db.Uuid
  odometerReading            Int?                      @map("odometer_reading")
  triggerType                MaintenanceTriggerType?   @map("trigger_type")
  intervalKm                 Int?                      @map("interval_km")
  bufferDistanceKm           Int?                      @map("buffer_distance_km")
  startingReferenceReadingKm Int?                      @map("starting_reference_reading_km")
  intervalType               MaintenanceIntervalType?  @map("interval_type")
  timeIntervalValue          Int?                      @map("time_interval_value")
  timeIntervalUnit           String?                   @map("time_interval_unit") @db.VarChar(6)
  startReferenceDate         DateTime?                 @map("start_reference_date") @db.Timestamptz(6)
  startDate                  DateTime?                 @map("start_date") @db.Date
  previousScheduleId         String?                   @unique @map("previous_schedule_id") @db.Uuid
  workOrderProgress          Json?                     @map("work_order_progress")
  partsCost                  Decimal?                  @map("parts_cost") @db.Decimal(10, 2)
  laborCost                  Decimal?                  @map("labor_cost") @db.Decimal(10, 2)
  totalCost                  Decimal?                  @map("total_cost") @db.Decimal(10, 2)
  deletedAt                  DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  completedAt                DateTime?                 @map("completed_at") @db.Timestamptz(6)
  createdAt                  DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  chiefMechanicUser    User?                             @relation("ScheduleChiefMechanic", fields: [chiefMechanicId], references: [id], onDelete: SetNull)
  assignedMechanicUser User?                             @relation("ScheduleMechanic", fields: [assignedMechanicId], references: [id], onDelete: SetNull)
  notifications        MaintenanceNotification[]
  cancellations        MaintenanceScheduleCancellation[]
  checklistTemplate    ChecklistTemplate?                @relation(fields: [checklistTemplateId], references: [id], onDelete: SetNull)
  previousSchedule     MaintenanceSchedule?              @relation("MaintenanceScheduleRecurrence", fields: [previousScheduleId], references: [id], onDelete: SetNull)
  nextSchedule         MaintenanceSchedule?              @relation("MaintenanceScheduleRecurrence")

  @@index([chiefMechanicId])
  @@index([assignedMechanicId])
  @@index([checklistTemplateId])
  @@index([deletedAt])
  @@map("maintenance_schedules")
}

model MaintenanceCostingSetting {
  id             String   @id @default("default") @db.VarChar(40)
  threshold      Decimal? @db.Decimal(12, 2)
  updatedById    String?  @map("updated_by_id") @db.Uuid
  updatedByEmail String?  @map("updated_by_email") @db.VarChar(255)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("maintenance_costing_settings")
}

model MaintenanceCostingThresholdAudit {
  id                String   @id @default(uuid()) @db.Uuid
  actorId           String   @map("actor_id") @db.Uuid
  actorEmail        String   @map("actor_email") @db.VarChar(255)
  previousThreshold Decimal? @map("previous_threshold") @db.Decimal(12, 2)
  newThreshold      Decimal  @map("new_threshold") @db.Decimal(12, 2)
  changedAt         DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  @@index([changedAt])
  @@index([actorId, changedAt])
  @@map("maintenance_costing_threshold_audit")
}

// ==========================================
// AUTH TOKENS
// ==========================================

model MaintenanceScheduleCancellation {
  id             String              @id @default(uuid()) @db.Uuid
  scheduleId     String              @map("schedule_id") @db.Uuid
  actorId        String              @map("actor_id") @db.Uuid
  actorName      String              @map("actor_name") @db.VarChar(100)
  actorEmail     String              @map("actor_email") @db.VarChar(255)
  reason         String              @db.Text
  previousStatus MaintenanceStatus   @map("previous_status")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  schedule       MaintenanceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@index([scheduleId, createdAt])
  @@map("maintenance_schedule_cancellations")
}

model LoginActivity {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  email      String   @db.VarChar(255)
  event      String   @db.VarChar(30)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  deviceType String   @map("device_type") @db.VarChar(30)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("login_activities")
}

model MaintenanceNotification {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  scheduleId    String              @map("schedule_id") @db.Uuid
  kind          String              @db.VarChar(20)
  message       String              @db.Text
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt        DateTime?           @map("read_at") @db.Timestamptz(6)
  smsStatus     String              @default("PENDING") @map("sms_status") @db.VarChar(20)
  smsProviderId String?             @map("sms_provider_id") @db.VarChar(100)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule      MaintenanceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([userId, scheduleId, kind])
  @@index([userId, createdAt])
  @@map("maintenance_notifications")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id") @db.Uuid
  otp       String
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model RefreshToken {
  id             String   @id @default(cuid())
  userId         String   @map("user_id") @db.Uuid
  tokenHash      String   @unique @map("token_hash")
  clientPlatform String   @map("client_platform") @db.VarChar(10)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}
