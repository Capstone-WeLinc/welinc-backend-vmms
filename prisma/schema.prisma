// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ADMIN
  MECHANIC
  OPERATIONS
  CHIEF_MECHANIC
}

enum SystemType {
  VRMS
  VMMS
  BMS
}

enum VehicleStatus {
  AVAILABLE
  UNDER_REPAIR
  UNDER_MAINTENANCE
}

enum WorkOrderStatus {
  PENDING
  IN_PROGRESS
  FOR_VERIFICATION
  COMPLETED
  CANCELLED
}

enum AccountType {
  IN_HOUSE
  OUTSOURCED
}

enum MaintenanceStatus {
  PENDING
  DUE
  IN_PROGRESS
  DONE
  COMPLETED
  OVERDUE
  CANCELLED
}

enum MaintenanceApprovalStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
  FOR_REPAIR
}

enum MaintenanceCancellationReviewStatus {
  PENDING
  APPROVED
  REJECTED
  LEGACY
}

enum MaintenanceScheduleExtensionReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MaintenanceScheduleExtensionAuditEventType {
  REQUESTED
  APPROVED
  REJECTED
}

enum MaintenanceScheduleRescheduleSource {
  MANUAL_UPDATE
  EXTENSION_APPROVAL
}

enum MaintenanceTriggerType {
  MANUAL
  ODOMETER
  TIME
}

enum MaintenanceIntervalType {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUALLY
  ANNUALLY
}

// ==========================================
// MODELS
// ==========================================

model Notification {
  id                    String               @id @default(uuid()) @db.Uuid
  userId                String               @map("user_id") @db.Uuid
  title                 String               @db.VarChar(200)
  message               String               @db.Text
  type                  String               @default("info") @db.VarChar(30)
  dedupeKey             String?              @unique @map("dedupe_key") @db.VarChar(255)
  maintenanceScheduleId String?              @map("maintenance_schedule_id") @db.Uuid
  maintenanceSchedule   MaintenanceSchedule? @relation(fields: [maintenanceScheduleId], references: [id], onDelete: SetNull)
  isRead                Boolean              @default(false) @map("is_read")
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model ScheduledFleetReport {
  id          String   @id @default(uuid()) @db.Uuid
  reportType  String   @map("report_type") @db.VarChar(20)
  periodKey   String   @map("period_key") @db.VarChar(10)
  data        Json     @db.JsonB
  generatedAt DateTime @default(now()) @map("generated_at") @db.Timestamptz(6)

  @@unique([reportType, periodKey])
  @@map("scheduled_fleet_reports")
}

model Vehicle {
  id                           String                      @id @default(uuid()) @db.Uuid
  plateNumber                  String                      @unique @map("plate_number") @db.VarChar(20)
  make                         String?                     @db.VarChar(80)
  model                        String                      @db.VarChar(100)
  year                         Int?
  engineType                   String?                     @map("engine_type") @db.VarChar(50)
  truckSizeCategory            String?                     @map("truck_size_category") @db.VarChar(50)
  capacity                     Int                         @default(0) @map("capacity")
  status                       VehicleStatus               @default(AVAILABLE)
  odometer                     Int                         @default(0)
  defaultMaintenanceIntervalKm Int?                        @map("default_maintenance_interval_km")
  defaultMaintenanceBufferKm   Int?                        @map("default_maintenance_buffer_km")
  garageId                     String?                     @map("garage_id") @db.Uuid
  workOrders                   WorkOrder[]
  isActive                     Boolean                     @default(true) @map("is_active")
  deletedAt                    DateTime?                   @map("deleted_at") @db.Timestamptz(6)
  createdAt                    DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  auditLogs                    VehicleAuditLog[]
  fuelFillUps                  FuelFillUp[]
  fuelAnomalies                FuelAnomaly[]
  maintenanceDefaults          VehicleMaintenanceDefault[]
  garage                       Garage?                     @relation(fields: [garageId], references: [id], onDelete: Restrict)

  @@index([deletedAt])
  @@map("vehicles")
}

model Garage {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @unique @db.VarChar(50) // Sta. Rosa, Marikina, Pulilan
  isActive   Boolean     @default(true) @map("is_active")
  deletedAt  DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  vehicles   Vehicle[]
  workOrders WorkOrder[]

  @@index([deletedAt])
  @@map("garages")
}

model OutsourcedProvider {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(150)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, name])
  @@map("outsourced_providers")
}

model FuelStation {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique @db.VarChar(100)
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  fillUps   FuelFillUp[]

  @@map("fuel_stations")
}

model FuelAnomalySetting {
  id               String   @id @default("default") @db.VarChar(40)
  thresholdPercent Decimal  @default(20) @map("threshold_percent") @db.Decimal(5, 2)
  updatedById      String?  @map("updated_by_id") @db.Uuid
  updatedByEmail   String?  @map("updated_by_email") @db.VarChar(255)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("fuel_anomaly_settings")
}

model FuelAnomalyThresholdAudit {
  id                String   @id @default(uuid()) @db.Uuid
  actorId           String   @map("actor_id") @db.Uuid
  actorEmail        String   @map("actor_email") @db.VarChar(255)
  previousThreshold Decimal? @map("previous_threshold") @db.Decimal(5, 2)
  newThreshold      Decimal  @map("new_threshold") @db.Decimal(5, 2)
  changedAt         DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  @@index([changedAt])
  @@index([actorId, changedAt])
  @@map("fuel_anomaly_threshold_audits")
}

model FuelImportDraft {
  id              String   @id @default(uuid()) @db.Uuid
  ownerAuthUserId String   @map("owner_auth_user_id") @db.VarChar(255)
  sourceName      String   @map("source_name") @db.VarChar(255)
  rows            Json     @default("[]") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ownerAuthUserId, updatedAt])
  @@map("fuel_import_drafts")
}

model FuelFillUp {
  id                  String                 @id @default(uuid()) @db.Uuid
  vehicleId           String                 @map("vehicle_id") @db.Uuid
  stationId           String                 @map("station_id") @db.Uuid
  stationNameSnapshot String                 @map("station_name_snapshot") @db.VarChar(100)
  filledBy            String                 @map("filled_by") @db.VarChar(100)
  enteredById         String                 @map("entered_by_id") @db.Uuid
  entryDate           DateTime               @map("entry_date") @db.Date
  liters              Decimal                @db.Decimal(10, 2)
  pricePerLiter       Decimal                @map("price_per_liter") @db.Decimal(10, 2)
  totalCost           Decimal                @map("total_cost") @db.Decimal(12, 2)
  poNumber            String?                @map("po_number") @db.VarChar(100)
  siNumber            String?                @map("si_number") @db.VarChar(100)
  product             String?                @db.VarChar(100)
  odometer            Int
  isFullTank          Boolean                @default(false) @map("is_full_tank")
  isVoided            Boolean                @default(false) @map("is_voided")
  voidReason          String?                @map("void_reason") @db.Text
  voidedById          String?                @map("voided_by_id") @db.Uuid
  voidedAt            DateTime?              @map("voided_at") @db.Timestamptz(6)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  vehicle             Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  station             FuelStation            @relation(fields: [stationId], references: [id], onDelete: Restrict)
  anomaly             FuelAnomaly?
  audits              FuelAuditLog[]
  receipt             FuelReceiptAttachment?

  @@index([vehicleId, entryDate, createdAt])
  @@index([isVoided, entryDate])
  @@map("fuel_fill_ups")
}

model FuelAnomaly {
  id               String                  @id @default(uuid()) @db.Uuid
  fillUpId         String                  @unique @map("fill_up_id") @db.Uuid
  vehicleId        String                  @map("vehicle_id") @db.Uuid
  efficiency       Decimal                 @db.Decimal(10, 2)
  rollingAverage   Decimal                 @map("rolling_average") @db.Decimal(10, 2)
  status           String                  @default("OPEN") @db.VarChar(20)
  note             String?                 @db.Text
  notedAt          DateTime?               @map("noted_at") @db.Timestamptz(6)
  notedById        String?                 @map("noted_by_id") @db.Uuid
  acknowledgedAt   DateTime?               @map("acknowledged_at") @db.Timestamptz(6)
  acknowledgedById String?                 @map("acknowledged_by_id") @db.Uuid
  acknowledgment   String?                 @db.Text
  attachments      FuelAnomalyAttachment[]
  resolvedAt       DateTime?               @map("resolved_at") @db.Timestamptz(6)
  resolvedById     String?                 @map("resolved_by_id") @db.Uuid
  notifiedDay1At   DateTime?               @map("notified_day_1_at") @db.Timestamptz(6)
  notifiedDay3At   DateTime?               @map("notified_day_3_at") @db.Timestamptz(6)
  notifiedDay7At   DateTime?               @map("notified_day_7_at") @db.Timestamptz(6)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  fillUp           FuelFillUp              @relation(fields: [fillUpId], references: [id], onDelete: Restrict)
  vehicle          Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("fuel_anomalies")
}

model FuelAnomalyAttachment {
  id           String      @id @default(uuid()) @db.Uuid
  anomalyId    String      @map("anomaly_id") @db.Uuid
  name         String      @db.VarChar(255)
  storageName  String      @map("storage_name") @db.VarChar(255)
  contentType  String      @map("content_type") @db.VarChar(100)
  uploadedById String      @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  anomaly      FuelAnomaly @relation(fields: [anomalyId], references: [id], onDelete: Cascade)

  @@index([anomalyId, createdAt])
  @@map("fuel_anomaly_attachments")
}

model FuelReceiptAttachment {
  id           String     @id @default(uuid()) @db.Uuid
  fillUpId     String     @unique @map("fill_up_id") @db.Uuid
  name         String     @db.VarChar(255)
  storageName  String     @map("storage_name") @db.VarChar(255)
  contentType  String     @map("content_type") @db.VarChar(100)
  uploadedById String     @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  fillUp       FuelFillUp @relation(fields: [fillUpId], references: [id], onDelete: Cascade)

  @@map("fuel_receipt_attachments")
}

model FuelAuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  fillUpId   String?     @map("fill_up_id") @db.Uuid
  actorId    String      @map("actor_id") @db.Uuid
  actorEmail String      @map("actor_email") @db.VarChar(255)
  action     String      @db.VarChar(40)
  reason     String?     @db.Text
  details    Json?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  fillUp     FuelFillUp? @relation(fields: [fillUpId], references: [id], onDelete: Restrict)

  @@index([fillUpId, createdAt])
  @@index([actorId, createdAt])
  @@map("fuel_audit_logs")
}

model Mechanic {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @unique @map("user_id") @db.Uuid // welinc-auth person id; intentionally no foreign key
  email          String?  @db.VarChar(255)
  role           String?  @db.VarChar(30)
  temporaryRoles String[] @default([]) @map("temporary_roles")
  name           String   @db.VarChar(100)
  isOutsourced   Boolean  @default(false) @map("is_outsourced")
  shopName       String?  @map("shop_name") @db.VarChar(100) // For outsourced "Other" shop names
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workOrders WorkOrder[] @relation("WorkOrderMechanics")

  @@map("mechanics")
}

enum MaintenancePriority {
  HIGH
  MEDIUM
  LOW
}

model WorkOrder {
  id                       String          @id @default(uuid()) @db.Uuid
  workOrderNumber          String          @unique @map("work_order_number") @db.VarChar(50)
  status                   WorkOrderStatus @default(PENDING)
  vehicleId                String          @map("vehicle_id") @db.Uuid
  garageId                 String          @map("garage_id") @db.Uuid
  odometer                 Int
  targetDueDate            DateTime?       @map("target_due_date") @db.Timestamptz(6)
  durationDays             Int?            @map("duration_days")
  durationHours            Int?            @map("duration_hours")
  partsCost                Decimal?        @map("parts_cost") @db.Decimal(10, 2)
  laborCost                Decimal?        @map("labor_cost") @db.Decimal(10, 2)
  totalCost                Decimal?        @map("total_cost") @db.Decimal(10, 2)
  isLumpSum                Boolean         @default(false) @map("is_lump_sum")
  cancellationReason       String?         @map("cancellation_reason") @db.Text
  failedVerificationReason String?         @map("failed_verification_reason") @db.Text
  remarks                  String?         @db.Text
  isUnlocked               Boolean         @default(false) @map("is_unlocked")
  unlockReason             String?         @map("unlock_reason") @db.Text
  isArchived               Boolean         @default(false) @map("is_archived")
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt              DateTime?       @map("completed_at") @db.Timestamptz(6)

  vehicle        Vehicle         @relation(fields: [vehicleId], references: [id])
  garage         Garage          @relation(fields: [garageId], references: [id])
  issues         RepairIssue[]
  mechanics      Mechanic[]      @relation("WorkOrderMechanics")
  repairParts    RepairPart[]
  shopChangeLogs ShopChangeLog[]
  auditLogs      AuditLog[]

  @@index([status, createdAt])
  @@index([vehicleId])
  @@map("work_orders")
}

model RepairIssue {
  id          String   @id @default(uuid()) @db.Uuid
  workOrderId String   @map("work_order_id") @db.Uuid
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("repair_issues")
}

model RepairPart {
  id          String   @id @default(uuid()) @db.Uuid
  workOrderId String   @map("work_order_id") @db.Uuid
  description String   @db.VarChar(255)
  unitCost    Decimal  @map("unit_cost") @db.Decimal(10, 2)
  quantity    Int      @default(1)
  subtotal    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("repair_parts")
}

model ShopChangeLog {
  id              String   @id @default(uuid()) @db.Uuid
  workOrderId     String   @map("work_order_id") @db.Uuid
  changedByUserId String   @map("changed_by_user_id") @db.Uuid
  changedByName   String   @map("changed_by_name") @db.VarChar(100)
  previousValue   String   @map("previous_value") @db.VarChar(255)
  newValue        String   @map("new_value") @db.VarChar(255)
  changedAt       DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  @@map("shop_change_logs")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  workOrderId   String   @map("work_order_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  email         String   @db.VarChar(100)
  action        String   @db.VarChar(100)
  fieldName     String?  @map("field_name") @db.VarChar(50)
  previousValue String?  @map("previous_value") @db.Text
  newValue      String?  @map("new_value") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  @@index([workOrderId, createdAt])
  @@map("audit_logs")
}

model VehicleAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  vehicleId     String   @map("vehicle_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  email         String   @db.VarChar(100)
  action        String   @db.VarChar(100)
  fieldName     String   @map("field_name") @db.VarChar(50)
  previousValue String?  @map("previous_value") @db.Text
  newValue      String?  @map("new_value") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([vehicleId, createdAt])
  @@index([userId, createdAt])
  @@map("vehicle_audit_logs")
}

model ChecklistTemplate {
  id              String                      @id @default(uuid()) @db.Uuid
  type            String                      @db.VarChar(100) // Oil Change, Brake Inspection, etc.
  items           ChecklistItem[]
  schedules       MaintenanceSchedule[]
  vehicleDefaults VehicleMaintenanceDefault[]
  deletedAt       DateTime?                   @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([type])
  @@index([deletedAt])
  @@map("checklist_templates")
}

model VehicleMaintenanceDefault {
  vehicleId           String   @map("vehicle_id") @db.Uuid
  checklistTemplateId String   @map("checklist_template_id") @db.Uuid
  intervalKm          Int      @map("interval_km")
  bufferDistanceKm    Int      @map("buffer_distance_km")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle           Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  checklistTemplate ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id], onDelete: Cascade)

  @@id([vehicleId, checklistTemplateId])
  @@map("vehicle_maintenance_defaults")
}

model ChecklistItem {
  id                  String    @id @default(uuid()) @db.Uuid
  checklistTemplateId String    @map("checklist_template_id") @db.Uuid
  text                String    @db.Text
  order               Int       @default(0)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  checklistTemplate ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id], onDelete: Cascade)

  @@index([checklistTemplateId])
  @@index([deletedAt])
  @@map("checklist_items")
}

model MaintenanceSchedule {
  id                         String                    @id @default(uuid()) @db.Uuid
  workOrderNumber            String                    @unique @default(dbgenerated("('WO-'::text || to_char(CURRENT_DATE, 'YYYYMMDD'::text) || '-'::text || lpad(nextval('maintenance_schedule_work_order_number_seq'::regclass)::text, 6, '0'::text))")) @map("work_order_number") @db.VarChar(32)
  logNumber                  String?                   @unique @map("log_number") @db.VarChar(32)
  vehicleId                  String                    @db.VarChar(50)
  title                      String                    @db.VarChar(100)
  garageId                   String?                   @map("garage_id") @db.VarChar(50)
  status                     MaintenanceStatus         @default(PENDING)
  priority                   MaintenancePriority       @default(MEDIUM)
  approvalStatus             MaintenanceApprovalStatus @default(UNVERIFIED) @map("approval_status")
  assignedMechanic           String                    @map("assigned_mechanic") @db.VarChar(100)
  assignedMechanicId         String?                   @map("assigned_mechanic_id") @db.Uuid
  chiefMechanicId            String?                   @map("chief_mechanic_id") @db.Uuid
  chiefMechanic              String?                   @map("chief_mechanic") @db.VarChar(100)
  accountType                AccountType?              @map("account_type")
  outsourcedProvider         String?                   @map("outsourced_provider") @db.VarChar(150)
  checklistTemplateId        String?                   @map("checklist_template_id") @db.Uuid
  odometerReading            Int?                      @map("odometer_reading")
  triggerType                MaintenanceTriggerType?   @map("trigger_type")
  intervalKm                 Int?                      @map("interval_km")
  bufferDistanceKm           Int?                      @map("buffer_distance_km")
  startingReferenceReadingKm Int?                      @map("starting_reference_reading_km")
  intervalType               MaintenanceIntervalType?  @map("interval_type")
  timeIntervalValue          Int?                      @map("time_interval_value")
  timeIntervalUnit           String?                   @map("time_interval_unit") @db.VarChar(6)
  startReferenceDate         DateTime?                 @map("start_reference_date") @db.Timestamptz(6)
  startDate                  DateTime?                 @map("start_date") @db.Date
  targetDueDate              DateTime?                 @map("target_due_date") @db.Date
  previousScheduleId         String?                   @unique @map("previous_schedule_id") @db.Uuid
  workOrderProgress          Json?                     @map("work_order_progress")
  partsCost                  Decimal?                  @map("parts_cost") @db.Decimal(10, 2)
  laborCost                  Decimal?                  @map("labor_cost") @db.Decimal(10, 2)
  totalCost                  Decimal?                  @map("total_cost") @db.Decimal(10, 2)
  deletedAt                  DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  completedAt                DateTime?                 @map("completed_at") @db.Timestamptz(6)
  createdAt                  DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  notifications             MaintenanceNotification[]
  systemNotifications       Notification[]
  cancellations             MaintenanceScheduleCancellation[]
  extensions                MaintenanceScheduleExtension[]
  extensionAudits           MaintenanceScheduleExtensionAudit[]
  rescheduleAudits          MaintenanceScheduleRescheduleAudit[]
  maintenanceLogEditUnlocks MaintenanceLogEditUnlock[]
  maintenanceLogEditAudits  MaintenanceLogEditAudit[]
  checklistTemplate         ChecklistTemplate?                   @relation(fields: [checklistTemplateId], references: [id], onDelete: SetNull)
  previousSchedule          MaintenanceSchedule?                 @relation("MaintenanceScheduleRecurrence", fields: [previousScheduleId], references: [id], onDelete: SetNull)
  nextSchedule              MaintenanceSchedule?                 @relation("MaintenanceScheduleRecurrence")

  @@index([chiefMechanicId])
  @@index([assignedMechanicId])
