PORT=3010
NODE_ENV=development
DATABASE_URL=postgresql://welinc_vmms_user:welinc_vmms_pass@vmms-db:5432/welinc_vmms_db?schema=public
AUTH_ISSUER=http://localhost:3000/auth
AUTH_JWKS_URL=http://auth-service:3001/auth/.well-known/jwks.json
AUTH_INTERNAL_URL=http://auth-service:3001
# Maximum time VMMS retries sending a repair referral to VRMS.
VMMS_REPAIR_REFERRAL_MAX_AGE_HOURS=24
AUTH_CLIENT_ID=vmms
# Secret: generated by scripts/setup.sh; keep empty in the example.
AUTH_CLIENT_PRIVATE_KEY=
WEB_APP_URL=http://localhost:8002
PORTAL_URL=http://localhost:8000
AUTH_PUBLIC_URL=http://localhost:3000/auth
API_PUBLIC_URL=http://localhost:3000
SESSION_COOKIE_SECURE=false
TRUST_PROXY_HOPS=1
CORS_ORIGINS=http://localhost:8000,http://localhost:8002
DB_POOL_MAX=2
# Only set to staging for an approved staging seed.
SEED_ALLOW=

# Local development uses Azurite; production uses managed identity.
STORAGE_CONNECTION_STRING=
STORAGE_ACCOUNT_URL=
STORAGE_CONTAINER=vmms-uploads

# Optional. Hosted staging uses managed identity; local OCR requires the endpoint and a key.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
# Local development only: ask the lead for a key. Never set or commit it in hosted environments.
AZURE_DOCUMENT_INTELLIGENCE_KEY=
